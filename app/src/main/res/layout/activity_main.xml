<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavigation">

        <!-- SCREEN 1: HOME -->
        <ScrollView
            android:id="@+id/screenHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/appLogo"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="40dp"
                    android:contentDescription="@string/app_logo_desc"
                    android:src="@mipmap/ic_launcher" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/title_text"
                    android:textColor="#111827"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="36dp"
                    android:text="@string/subtitle_text"
                    android:textColor="#6B7280"
                    android:textSize="14sp" />

                <!-- DAILY PROGRESS TRACKER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_input_field"
                    android:padding="20dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/todays_progress"
                        android:textColor="#374151"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/progressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#3B82F6"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="12dp"
                        android:max="2500"
                        android:progress="0"
                        android:progressTint="#3B82F6" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSubSmall"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/sub_250_ml"
                            app:backgroundTint="#FEE2E2"
                            android:textColor="#DC2626"
                            app:cornerRadius="16dp"
                            app:elevation="0dp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddSmall"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="@string/add_250_ml"
                            app:backgroundTint="#DBEAFE"
                            android:textColor="#1D4ED8"
                            app:cornerRadius="16dp"
                            app:elevation="0dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <EditText
                            android:id="@+id/customAmountInput"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:hint="@string/custom_ml_hint"
                            android:inputType="number"
                            android:autofillHints="none"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp"
                            android:textColor="#111827" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddCustom"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            app:backgroundTint="#DBEAFE"
                            android:paddingHorizontal="24dp"
                            android:text="@string/add_btn"
                            android:textColor="#1D4ED8"
                            app:cornerRadius="16dp"
                            app:elevation="0dp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- DAILY WATER GOAL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/goal_label"
                        android:textColor="#374151"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/goalInput"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input_field"
                            android:hint="@string/goal_hint"
                            android:inputType="numberDecimal"
                            android:autofillHints="none"
                            android:paddingHorizontal="16dp"
                            android:layout_marginEnd="8dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUpdateGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            app:backgroundTint="#DBEAFE"
                            android:paddingHorizontal="16dp"
                            android:text="@string/update_goal"
                            android:textColor="#1D4ED8"
                            app:cornerRadius="16dp"
                            app:elevation="0dp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SPYDY SCHEDULER SECTION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_input_field"
                    android:padding="20dp"
                    android:layout_marginBottom="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/spydy_reminders"
                        android:textColor="#374151"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:weightSum="2">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTabRepeat"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            app:backgroundTint="#1D4ED8"
                            android:text="@string/tab_repeat"
                            android:textColor="#FFFFFF"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"
                            android:layout_marginEnd="4dp"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTabAtTime"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            app:backgroundTint="#E5E7EB"
                            android:text="@string/tab_at_time"
                            android:textColor="#6B7280"
                            app:cornerRadius="12dp"
                            app:elevation="0dp"
                            android:layout_marginStart="4dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/inputRepeatInterval"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_input_field"
                        android:hint="@string/hint_interval"
                        android:inputType="numberDecimal"
                        android:autofillHints="none"
                        android:paddingHorizontal="16dp" />

                    <TextView
                        android:id="@+id/inputSpecificTime"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_input_field"
                        android:text="@string/hint_time"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:textColor="#6B7280"
                        android:textSize="16sp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddReminder"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="16dp"
                        app:backgroundTint="#111827"
                        android:text="@string/btn_add_reminder"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="16dp"
                        app:elevation="0dp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E5E7EB"
                        android:layout_marginVertical="20dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active_reminders"
                        android:textColor="#6B7280"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:id="@+id/activeRemindersContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

                <!-- THE MASTER CONTROL SWITCH -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/toggleSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="36dp"
                    android:text="@string/activate_reminder"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    app:backgroundTint="#111827"
                    android:text="@string/save_btn"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="16dp"
                    app:elevation="0dp"
                    android:textStyle="bold" />

            </LinearLayout>
        </ScrollView>

        <!-- SCREEN 2: CALENDAR -->
        <LinearLayout
            android:id="@+id/screenCalendar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="24dp"
            android:gravity="top|center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hydration_streak"
                android:textColor="#111827"
                android:textSize="24sp"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp" />

            <com.applandeo.materialcalendarview.CalendarView
                android:id="@+id/streakCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_field"
                app:headerColor="#DBEAFE"
                app:headerLabelColor="#1D4ED8"
                app:previousButtonSrc="@android:drawable/ic_media_previous"
                app:forwardButtonSrc="@android:drawable/ic_media_next"
                app:type="classic" />

            <TextView
                android:id="@+id/selectedDayIntakeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_input_field"
                android:padding="16dp"
                android:text="@string/tap_to_view"
                android:textAlignment="center"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav" />

</RelativeLayout>